{
  "name": "@spritestudio/ssplayer-wgpu",
  "version": "7.0.0-beta.1",
  "description": "SpriteStudio Player for wgpu in the browser: plays SpriteStudio animations (.ssab) on WebGPU, as an <ss-player-webgpu> element or many characters per canvas.",
  "keywords": [
    "spritestudio",
    "spritestudio7",
    "animation",
    "2d",
    "sprite",
    "skeletal-animation",
    "gamedev",
    "webgpu",
    "wgpu",
    "canvas",
    "web-component",
    "custom-element",
    "webassembly",
    "wasm",
    "zero-dependency"
  ],
  "author": "CRI Middleware Co., Ltd.",
  "homepage": "https://github.com/cri-middleware/SSPlayerForWgpu/tree/main/packages/ssplayer-wgpu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cri-middleware/SSPlayerForWgpu.git",
    "directory": "packages/ssplayer-wgpu"
  },
  "bugs": {
    "url": "https://github.com/cri-middleware/SSPlayerForWgpu/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./wasm/*": "./wasm/*",
    "./package.json": "./package.json"
  },
  "//typesVersions": "TypeScript only reads `exports` under moduleResolution bundler/node16+. Projects still on the legacy `\"node\"` resolution (common even when the bundler itself is Vite, which resolves the runtime import fine) would fail to find the ./element subpath. This maps it the old way so those projects typecheck.",
  "typesVersions": {
    "*": {
      "element": ["./dist/element.d.ts"]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "wasm",
    "docs",
    "README.md",
    "README.ja.md",
    "LICENSE.md",
    "LICENSE.ja.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/verify-publish-artifacts.mjs"
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
